{
  "name": "beat-gurus-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "lighthouse:mobile": "npm run build && lhci autorun --config=./lighthouserc.mobile.json",
    "lighthouse:desktop": "npm run build && lhci autorun --config=./lighthouserc.desktop.json",
    "lighthouse": "npm run lighthouse:mobile && npm run lighthouse:desktop"
  },
  "dependencies": {
    "framer-motion": "^10.16.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.17",
    "lucide-react": "^0.577.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "split-type": "^0.3.4"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.0.8"
  }
}
